{
  "msrv": {
    "command": [
      "cargo",
      "+1.85.0",
      "check",
      "--workspace",
      "--all-targets",
      "--all-features",
      "--locked",
      "--offline"
    ],
    "exit_code": 0
  },
  "default-feature": {
    "command": [
      "cargo",
      "check",
      "-p",
      "modorch-mqtt",
      "--no-default-features",
      "--locked",
      "--offline"
    ],
    "exit_code": 0
  },
  "toml-only": {
    "command": [
      "cargo",
      "test",
      "-p",
      "modorch-mqtt",
      "--no-default-features",
      "--features",
      "toml",
      "--test",
      "config",
      "--locked",
      "--offline"
    ],
    "exit_code": 0
  },
  "examples-build": {
    "command": [
      "cargo",
      "build",
      "-p",
      "standalone-broker",
      "-p",
      "secure-modorch-server",
      "-p",
      "durable-broker",
      "--locked",
      "--offline"
    ],
    "exit_code": 0
  }
}
