        "tests::auth::handshake_deadline_during_authentication_closes_tcp_and_tls_without_late_session",
        "tests::storage::actual_committed_store_timeout_is_resolved_by_original_operation_before_next_commit",
        "tests::storage::paginated_recovery_deadline_closes_ingress_and_retry_preserves_committed_image",
        "tests::storage::ping_on_idle_connection_does_not_wait_for_another_connections_store_commit",
        "tests::storage::store_diagnostics_distinguish_admission_queued_running_and_provider_failures",
        "tests::auth::handshake_deadline_during_session_authorization_closes_tcp_and_tls_without_late_session"
      ]
