{
  "version": 1,
  "claim": "仅实验功能限定场景的执行证据；不是完整 MQTT5、WebSocket/Bridge 规范或生产发布批准。",
  "scenarios": [
    {
      "id": "OPT-HOST",
      "scope": "调用方Runtime中的独立Application、失败启动补偿与检查式退出",
      "tests": [
        "tokio_adapter_isolates_applications_and_releases_ports_on_checked_shutdown",
        "tokio_adapter_preserves_failed_startup_cleanup_and_retry_handle"
      ]
    },
    {
      "id": "OPT-WS",
      "scope": "独立字节二进制QoS2、分片/合并、升级拒绝和退出",
      "tests": [
        "tests::websocket::websocket_binary_fragmented_mqtt_qos2_upgrade_isolation_and_shutdown"
      ]
    },
    {
      "id": "OPT-MQTT5",
      "scope": "混合3.1.1/5.0、属性/别名/选项/流控/过期/共享/负ACK及Will、在线零过期Session接管、桥接属性独立限额及幂等恢复预算/校验、跨协议恢复拒绝/显式清理重建、混合监听包长边界恢复、No Local来源持久化和旧格式保守迁移、合法Topic Alias展开的持久恢复/完整预算及线帧拒绝边界",
      "tests": [
        "tests::mqtt5::mqtt5_alias_metadata_subscription_options_window_unsubscribe_and_mixed311",
        "tests::mqtt5::mqtt5_delayed_will_cancel_resume_session_expiry_and_message_expiry",
        "tests::mqtt5::mqtt5_shared_groups_distribute_and_invalid_properties_close_only_offender",
        "tests::mqtt5::mqtt5_negotiated_packet_limit_discards_oversized_delivery_without_blocking_session",
        "tests::mqtt5::mqtt5_negative_pubrec_releases_ownership_and_disconnect_four_publishes_will",
        "tests::storage::mqtt5_sqlite_restart_preserves_options_metadata_and_qos2_ownership",
        "tests::mqtt5::mqtt5_online_zero_expiry_takeover_preserves_subscriptions_and_both_qos2_directions",
        "tests::mqtt5::mqtt5_user_property_limits_reserve_two_unique_bridge_slots_and_preserve_byte_limits",
        "tests::storage::mqtt5_sqlite_idempotency_properties_keep_their_budget_and_identity_after_restart",
        "state::snapshot::tests::mqtt5_idempotency_restore_validates_real_properties_and_refuses_insufficient_budget",
        "tests::storage::mixed_protocol_session_resume_is_rejected_before_fencing_and_clean_switch_survives_restart",
        "tests::storage::mixed_listener_sqlite_restores_packet_boundary_retained_pending_qos2_and_will",
        "tests::storage::mqtt5_no_local_retained_origin_survives_clean_reconnect_and_sqlite_restart",
        "state::snapshot::regressions::cross_protocol_resume_rejection_keeps_both_qos2_directions_ids_and_owner",
        "state::snapshot::regressions::retained_origin_legacy_migration_filters_no_local_and_rejects_invalid_ledger_atomically",
        "state::snapshot::regressions::recovery_packet_bounds_cover_empty_metadata_real_properties_and_broker_identifiers",
        "state::snapshot::alias_regressions::alias_recovery_checks_binding_real_properties_budget_and_nonnetwork_limits",
        "tests::storage::mqtt5_alias_expansion_sqlite_restores_retained_both_qos2_directions_and_real_properties",
        "tests::mqtt5::mqtt5_alias_rejects_invalid_unbound_reconnected_oversize_and_unfunded_messages_atomically"
      ]
    },
    {
      "id": "OPT-BRIDGE",
      "scope": "两个真实Broker、远端离线的源所有权、恢复、双向防环和退出、目标Session丢失/恢复后的单交换重发、126/127/128普通属性加保留元数据端到端保留、源Session代际隔离/新订阅延后、同/不同Packet ID、连续源会话丢失及两端同时丢失、源恢复及重连期间目标确认",
      "tests": [
        "bridge_retains_source_ownership_until_remote_recovers_and_filters_bidirectional_loop",
        "bridge_rejected_subscription_reconnects_with_backoff_and_recovers",
        "bridge_target_session_loss_resubmits_and_resumed_session_replays_one_exchange",
        "bridge_preserves_128_ordinary_properties_plus_reserved_metadata_end_to_end",
        "bridge_source_session_loss_fences_old_ack_and_preserves_reused_and_distinct_ids",
        "bridge_source_resume_and_destination_ack_during_source_reconnect_keep_ack_identity"
      ]
    },
    {
      "id": "OPT-RELOAD",
      "scope": "策略revision fencing、失败证书不替换、真实新证书及原TLS会话",
      "tests": [
        "policy_replacement_uses_new_revision_and_rejects_stale_or_changed_identity",
        "tests::tls::tls_reload_is_atomic_failed_reload_preserves_certificate_and_existing_sessions"
      ]
    },
    {
      "id": "OPT-HTTP-AUDIT",
      "scope": "令牌验证、可信Admin转发、分页/指标、慢Header退出与跨应用审计数据库",
      "tests": [
        "http_authenticates_forwards_admin_exports_metrics_and_drains_slow_headers",
        "persistent_audit_survives_application_restart_and_rejects_unrelated_database"
      ]
    },
    {
      "id": "OPT-CONFIG",
      "scope": "编译Feature与运行时启用分别校验",
      "tests": [
        "optional_network_features_require_compilation_and_explicit_configuration"
      ]
    }
  ]
}
